{
  "name": "dsh-model-control",
  "description": "Unified model control for DeepSeek Harness: model picker (search/favorites/fold/chips/facts) + model management (channels, per-model capabilities) + reasoning-effort advisory (knowledge base, per-model defaults), in one seat and one settings page.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uio-o/dsh-model-control.git"
  },
  "homepage": "https://github.com/uio-o/dsh-model-control#readme",
  "bugs": {
    "url": "https://github.com/uio-o/dsh-model-control/issues"
  },
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "picker",
    "reasoning-effort",
    "web"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  }
}
